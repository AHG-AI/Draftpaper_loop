      "environment": "local-mac",
      "script_id": "deploy-local"
    }
  ],
  "secrets_policy": {
    "runtime_env_files": [".env.local"],
    "forbidden_in_repo": [".env", ".env.*"],
    "notes": "Zotero, SerpApi, Semantic Scholar keys, optional DRAFTPAPER_CONSOLE_TOKEN, DRAFTPAPER_CONSOLE_USERS_FILE, DRAFTPAPER_BILLING_RATES_FILE, DRAFTPAPER_LICENSE_FILE, DRAFTPAPER_CLAIM_CONFIRMATION_FILE, DRAFTPAPER_CLAIM_CONFIRMATION_PROJECT, DRAFTPAPER_COMMERCIAL_APPROVAL_FILE, DRAFTPAPER_RELEASE_TRUST_FILE, DRAFTPAPER_SECURITY_REVIEW_FILE, DRAFTPAPER_HANDOFF_ENV_FILE, DRAFTPAPER_HOSTED_READINESS_FILE, DRAFTPAPER_BACKUPS_DIR, and local operator limits such as DRAFTPAPER_MAX_CONCURRENT_JOBS stay in local/private runtime files. DRAFTPAPER_LICENSE_PUBLIC_KEY_SHA256 is a non-secret license verification trust pin. Release packaging excludes .env*, .pem, .key, .sig, and known private runtime JSON files such as console-users.json, billing-rates.json, commercial-license-grant.json, claim-confirmation.json, claim-confirmation-verification.json, commercial-approval.json, commercial-approval-verification.json, release-trust.json, release-trust-verification.json, security-review.json, security-review-verification.json, and active-handoff.env. License signatures and public keys generated for a customer handoff belong in private runtime handoff directories, not the source package. The console never returns secret values."
  },
